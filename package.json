{
  "name": "evermemos-dev-vscode",
  "displayName": "EverMemOS for VS Code",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "HPC2H2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:evermem.configView",
    "onCommand:evermem.addMemory",
    "onCommand:evermem.quickRecap",
    "onCommand:evermem.projectOverview",
    "onCommand:evermem.deleteMemory",
    "onCommand:evermem.openSidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "evermemViewContainer",
          "title": "EverMemOS",
          "icon": "media/evermem.svg"
        }
      ]
    },
    "views": {
      "evermemViewContainer": [
        {
          "id": "evermem.configView",
          "name": "%view.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "evermem.addMemory",
        "title": "%command.addMemory%",
        "category": "EverMemOS"
      },
      {
        "command": "evermem.quickRecap",
        "title": "%command.quickRecap%",
        "category": "EverMemOS"
      },
      {
        "command": "evermem.projectOverview",
        "title": "%command.projectOverview%",
        "category": "EverMemOS"
      },
      {
        "command": "evermem.deleteMemory",
        "title": "%command.deleteMemory%",
        "category": "EverMemOS"
      },
      {
        "command": "evermem.openSidebar",
        "title": "%command.openSidebar%",
        "category": "EverMemOS"
      }
    ],
    "keybindings": [
      {
        "command": "evermem.addMemory",
        "key": "alt+m",
        "mac": "alt+m",
        "when": "editorTextFocus"
      },
      {
        "command": "evermem.quickRecap",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "EverMemOS",
      "properties": {
        "evermem.apiBaseUrl": {
          "type": "string",
          "default": "https://api.evermind.ai",
          "description": "%config.apiBaseUrl%"
        },
        "evermem.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.apiKey%"
        },
        "evermem.authToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.authToken%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run test:unit && node ./out/test/runTest.js",
    "test:unit": "npm run compile-tests && node --test test/*.test.cjs"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.3",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "mocha": "^12.0.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "l10n": "./l10n"
}
